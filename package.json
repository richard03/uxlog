{
  "name": "uxlog",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:dev": "node scripts/check-build-cache.js && tauri dev",
    "tauri:build": "node scripts/check-build-cache.js && tauri build && node scripts/copy-installers.js",
    "build:cli": "vite build --config vite.cli.config.js --logLevel warn",
    "predev": "npm run build:cli",
    "prebuild": "npm run build:cli",
    "pretest": "npm run build:cli"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-shell": "^2",
    "jspdf": "^4.2.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.38",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.4",
    "pdfmake": "^0.3.7",
    "vite": "^5.2.0",
    "vitest": "^2.0.5"
  }
}
