<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Předat Authorization do PHP (flexi-proxy.php a Bearer token z Figmy)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%0]

  # Předat Origin do PHP (Figma plugin posílá Origin: null)
  RewriteCond %{HTTP:Origin} .
  RewriteRule .* - [E=HTTP_ORIGIN:%0]

  # Pokud požadavek směřuje na existující soubor nebo složku, ponechat beze změny
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Všechny ostatní požadavky přesměrovat na index.html (SPA fallback)
  RewriteRule . /index.html [L]
</IfModule>
